# AdMob (Google Mobile Ads SDK) identifiers.
# None of these are secret — they're public identifiers that ship inside the app binary
# regardless — this file is just here to keep them out of app.json/source and easy to swap.

# App-level ID from the AdMob console (Apps > App settings). Registered for iOS only so far;
# Android still falls back to Google's official test App ID in app.config.js until an Android
# app is registered in AdMob too.
ADMOB_IOS_APP_ID=ca-app-pub-3981993675235210~2254370039

# Rewarded ad unit used for the "watch an ad to unlock" gates (NFC write, new theme, 2nd+ preset).
# Must be EXPO_PUBLIC_-prefixed since it's read at runtime in the client bundle (lib/ads.ts).
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3981993675235210/8690263368
